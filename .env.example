# ==========================================
# Yatra AI — Environment Configuration
# ==========================================

# Core LLM API Keys (Required)
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_API_KEY=your-google-ai-api-key

# MCP Server API Keys (Required for live tools)
GMAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-openweathermap-api-key
IRCTC_API_KEY=your-irctc-api-key-if-required
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=yatra-ai

# Local Storage & Config Paths
MCP_CONFIG_PATH=yatra_agent/config/servers_config.json
CHROMA_PERSIST_DIR=./data/travel_vectordb
TRAVEL_DOCS_DIR=./data/travel_docs
